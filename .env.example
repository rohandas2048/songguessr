# Spotify app credentials — https://developer.spotify.com/dashboard
# Genre, artist and album modes work without these; playlist mode needs them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the Spotify app.
# Spotify rejects `localhost` over http — use the loopback IP.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
# Where the browser lands after the OAuth round trip (Vite's port in dev).
# Use the SAME HOSTNAME as SPOTIFY_REDIRECT_URI. The session cookie is scoped by host,
# so starting the login on localhost and returning to 127.0.0.1 silently loses it.
APP_URL=http://127.0.0.1:5173

PORT=3000
CACHE_DIR=.cache
# Saved playlist snapshots. Committed to the repo so they ship with the app.
PRESET_DIR=data/presets
# Set to "false" to switch off featured-list editing entirely, whatever the password says.
ALLOW_PRESET_WRITES=

# Password for editing the Featured list — saving a loaded playlist as featured, and
# removing one. Required: with this unset, the featured list is read-only for everyone,
# including you. 16+ random characters; it is the only guessable secret in the app.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
CURATOR_PASSWORD=

# Signs the session cookie. REQUIRED in production — the server refuses to start without
# it — and 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. Leave blank in dev for a per-boot ephemeral secret.
SESSION_SECRET=

# Bind address. Loopback by default; set 0.0.0.0 only when deploying behind a TLS proxy.
HOST=127.0.0.1
# Set when behind a reverse proxy so per-IP rate limiting sees the real client
# (e.g. "1" for one proxy hop). Leave unset otherwise — trusting it blindly lets
# clients spoof their address.
TRUST_PROXY=
